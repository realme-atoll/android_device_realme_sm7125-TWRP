# Android fstab file.
# mount_point  fstype   device                 device2                 flags

/system_root    ext4    /dev/block/mapper/system                      flags=removable
/system_ext     ext4    /dev/block/mapper/system_ext                  flags=removable
/product        ext4    /dev/block/mapper/product                     flags=removable
/vendor         ext4    /dev/block/mapper/vendor                      flags=removable
/odm            ext4    /dev/block/mapper/odm                         flags=removable

# Dynamic Partition Image Flashing
/system_image   emmc    /dev/block/mapper/system                      flags=display="System Image";flashimg=1
/system_ext_image emmc  /dev/block/mapper/system_ext                  flags=display="System_EXT Image";flashimg=1
/product_image  emmc    /dev/block/mapper/product                     flags=display="Product Image";flashimg=1
/vendor_image   emmc    /dev/block/mapper/vendor                      flags=display="Vendor Image";flashimg=1
/odm_image      emmc    /dev/block/mapper/odm                         flags=display="ODM Image";flashimg=1

# Core Boot / Kernel / Recovery Partitions
/boot           emmc    /dev/block/by-name/boot                       flags=display="Boot";flashimg=1;backup=1
/dtbo           emmc    /dev/block/by-name/dtbo                       flags=display="DTBO";flashimg=1;backup=1
/recovery       emmc    /dev/block/by-name/recovery                   flags=display="Recovery";flashimg=1;backup=1
/super          emmc    /dev/block/by-name/super                      flags=display="Super";backup=1;flashimg=1

# Android Verified Boot
/vbmeta         emmc    /dev/block/by-name/vbmeta                     flags=display="VBMeta";flashimg=1;backup=1
/vbmeta_system  emmc    /dev/block/by-name/vbmeta_system              flags=display="VBMeta System";flashimg=1;backup=1
/vbmeta_vendor  emmc    /dev/block/by-name/vbmeta_vendor              flags=display="VBMeta Vendor";flashimg=1;backup=1

# Storage & Cache
/metadata       ext4    /dev/block/by-name/metadata                   flags=display="Metadata";backup=1
/cache          ext4    /dev/block/by-name/cache                      flags=display="Cache"
/persist        ext4    /dev/block/by-name/persist                    flags=display="Persist";mounttodecrypt
/persist_image  emmc    /dev/block/by-name/persist                    flags=display="Persist Image";backup=1;flashimg=1
/splash         emmc    /dev/block/by-name/splash                     flags=display="Boot Logo";flashimg=1;backup=1

# Firmware & Radio
/firmware       vfat    /dev/block/by-name/modem                      flags=display="Firmware";mounttodecrypt;fsflags=ro
/modem          emmc    /dev/block/by-name/modem                      flags=display="Modem";backup=1

# EFS (IMEI / NVRAM)
/efs1           emmc    /dev/block/by-name/modemst1                   flags=display="EFS";backup=1
/efs2           emmc    /dev/block/by-name/modemst2                   flags=backup=1;subpartitionof=/efs1
/efsc           emmc    /dev/block/by-name/fsc                        flags=backup=1;subpartitionof=/efs1
/efsg           emmc    /dev/block/by-name/fsg                        flags=backup=1;subpartitionof=/efs1

# Removable Storage
/usb_otg        auto    /dev/block/sdg1        /dev/block/sdg         flags=display="USB-OTG";storage;wipeingui;removable;fsflags="utf8"
/external_sd    auto    /dev/block/mmcblk0p1   /dev/block/mmcblk0     flags=display="MicroSD";storage;wipeingui;removable;fsflags="nosuid,nodev,utf8"
