# Recovery fstab overlays and partition UI metadata.
# mount_point  fstype  device  device2  flags

# Dynamic partitions. Display labels use the conventional Android names.
/system_root    ext4    /dev/block/mapper/system                       flags=display="System";removable
/system_ext     ext4    /dev/block/mapper/system_ext                   flags=display="System-EXT";removable
/product        ext4    /dev/block/mapper/product                      flags=display="Product";removable
/vendor         ext4    /dev/block/mapper/vendor                       flags=display="Vendor";removable
/odm            ext4    /dev/block/mapper/odm                          flags=display="ODM";removable

# Cache is available as a wipe target; Dalvik / ART Cache is added separately
# by the recovery's Advanced Wipe screen.
/cache          ext4    /dev/block/by-name/cache                       flags=display="Cache";wipeingui
/metadata       ext4    /dev/block/by-name/metadata                    flags=display="Metadata";backup=0;wipeingui
/data           f2fs    /dev/block/platform/soc/1d84000.ufshc/by-name/userdata flags=display="Data";storagename="Internal Storage";backup=1;backupname="Data";wipeingui
/storage        ext4    /data/media/0                                  flags=display="Internal Storage";storagename="Internal Storage";storage;backup=1;backupname="Internal Storage";removable;usermrf;fsflags="bind,utf8"
/external_sd    auto    /dev/block/mmcblk0p1   /dev/block/mmcblk0      flags=display="MicroSD Card";storagename="MicroSD Card";storage;wipeingui;removable;fsflags="nosuid,nodev,utf8"
/usb_otg        auto    /dev/block/sdg1        /dev/block/sdg          flags=display="USB-Storage";storagename="USB-Storage";storage;wipeingui;removable;fsflags="utf8"

# The modem firmware filesystem is mountable; raw firmware partitions are backed
# up together under a distinct Firmware-update entry.
/firmware       vfat    /dev/block/by-name/modem                        flags=display="Firmware";mounttodecrypt;fsflags="ro";backup=0
/abl            emmc    /dev/block/by-name/abl                          flags=display="Firmware-update";backup=1;backupname="Firmware-update"
/aop            emmc    /dev/block/by-name/aop                          flags=backup=1;subpartitionof=/abl
/apdp           emmc    /dev/block/by-name/apdp                         flags=backup=1;subpartitionof=/abl
/bluetooth      emmc    /dev/block/by-name/bluetooth                    flags=backup=1;subpartitionof=/abl
/cmnlib         emmc    /dev/block/by-name/cmnlib                       flags=backup=1;subpartitionof=/abl
/cmnlib64       emmc    /dev/block/by-name/cmnlib64                     flags=backup=1;subpartitionof=/abl
/ddr            emmc    /dev/block/by-name/ddr                          flags=backup=1;subpartitionof=/abl
/devcfg         emmc    /dev/block/by-name/devcfg                       flags=backup=1;subpartitionof=/abl
/DRIVER         emmc    /dev/block/by-name/DRIVER                       flags=backup=1;subpartitionof=/abl
/dsp            emmc    /dev/block/by-name/dsp                          flags=backup=1;subpartitionof=/abl
/hyp            emmc    /dev/block/by-name/hyp                          flags=backup=1;subpartitionof=/abl
/keymaster      emmc    /dev/block/by-name/keymaster                    flags=backup=1;subpartitionof=/abl
/modem          emmc    /dev/block/by-name/modem                        flags=backup=1;subpartitionof=/abl
/msadp          emmc    /dev/block/by-name/msadp                        flags=backup=1;subpartitionof=/abl
/oppo_sec       emmc    /dev/block/by-name/oppo_sec                     flags=backup=1;subpartitionof=/abl
/oppostanvbk    emmc    /dev/block/by-name/oppostanvbk                  flags=backup=1;subpartitionof=/abl
/qupfw          emmc    /dev/block/by-name/qupfw                        flags=backup=1;subpartitionof=/abl
/splash         emmc    /dev/block/by-name/splash                       flags=backup=1;subpartitionof=/abl
/storsec        emmc    /dev/block/by-name/storsec                      flags=backup=1;subpartitionof=/abl
/tz             emmc    /dev/block/by-name/tz                           flags=backup=1;subpartitionof=/abl
/vbmeta_system  emmc    /dev/block/by-name/vbmeta_system                flags=backup=1;subpartitionof=/abl
/vbmeta_vendor  emmc    /dev/block/by-name/vbmeta_vendor                flags=backup=1;subpartitionof=/abl
/xbl            emmc    /dev/block/by-name/xbl                          flags=backup=1;subpartitionof=/abl
/xbl_config     emmc    /dev/block/by-name/xbl_config                   flags=backup=1;subpartitionof=/abl

# Core boot images. backupname defines the user-facing Backup/Restore label.
/boot           emmc    /dev/block/by-name/boot                         flags=display="Boot";backup=1;backupname="Boot";flashimg=1
/dtbo           emmc    /dev/block/by-name/dtbo                         flags=display="DTBO";backup=1;backupname="DTBO";flashimg=1
/recovery       emmc    /dev/block/by-name/recovery                     flags=display="Recovery";backup=1;backupname="Recovery";flashimg=1
/vbmeta         emmc    /dev/block/by-name/vbmeta                       flags=display="VBMeta";backup=1;backupname="VBMeta";flashimg=1

# EFS stores modem identity and calibration data; expose it as one backup.
/efs1           emmc    /dev/block/by-name/modemst1                     flags=display="EFS";backup=1;backupname="EFS"
/efs2           emmc    /dev/block/by-name/modemst2                     flags=backup=1;subpartitionof=/efs1
/efsc           emmc    /dev/block/by-name/fsc                          flags=backup=1;subpartitionof=/efs1
/efsg           emmc    /dev/block/by-name/fsg                          flags=backup=1;subpartitionof=/efs1

# Persist is mountable; the raw image is the single backup entry.
/persist        ext4    /dev/block/by-name/persist                      flags=display="Persist";backup=0;mounttodecrypt
/persist_image  emmc    /dev/block/by-name/persist                      flags=display="Persist";backup=1;backupname="Persist";flashimg=1

# Only the system logical image is listed separately. 
# Dynamic-partition support handles the aggregate Super backup.
/odm_image      emmc    /dev/block/mapper/odm                           flags=display="ODM Image";backup=0;flashimg=1
/product_image  emmc    /dev/block/mapper/product                       flags=display="Product Image";backup=0;flashimg=1
/system_ext_image emmc  /dev/block/mapper/system_ext                    flags=display="System-EXT Image";backup=0;flashimg=1
/system_image   emmc    /dev/block/mapper/system                        flags=display="System Image";backup=1;backupname="System Image";flashimg=1
/vendor_image   emmc    /dev/block/mapper/vendor                        flags=display="Vendor Image";backup=0;flashimg=1
