# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount_point    fstype  device                                       flags

# Dynamic Partitions
/system_root     auto    /dev/block/mapper/system                     flags=display="System";storagename="System";logical
/system_ext      auto    /dev/block/mapper/system_ext                 flags=display="System-EXT";storagename="System-EXT";logical
/product         auto    /dev/block/mapper/product                    flags=display="Product";storagename="Product";logical
/vendor          auto    /dev/block/mapper/vendor                     flags=display="Vendor";storagename="Vendor";logical
/odm             auto    /dev/block/mapper/odm                        flags=display="ODM";storagename="ODM";logical
/system_image    emmc    /dev/block/mapper/system                     flags=display="System Image";storagename="System Image";flashimg;backup=1

# Cache & Recovery Settings
/cache           ext4    /dev/block/by-name/cache                     flags=display="Cache";storagename="Cache"
#/custom         ext4    /dev/block/bootdevice/by-name/custom         flags=display="Custom";storagename="Custom";backup=0

# Core Kernel, Boot & Recovery Images
/boot            emmc    /dev/block/bootdevice/by-name/boot           flags=display="Boot";storagename="Boot";flashimg;backup=1
/dtbo            emmc    /dev/block/bootdevice/by-name/dtbo           flags=display="DTBO";storagename="DTBO";flashimg;backup=1
/recovery        emmc    /dev/block/bootdevice/by-name/recovery       flags=display="Recovery";storagename="Recovery";flashimg;backup=1
/vbmeta          emmc    /dev/block/bootdevice/by-name/vbmeta         flags=display="VBMeta";storagename="VBMeta";flashimg;backup=1

# Modem Firmware Backup
/firmware        vfat    /dev/block/bootdevice/by-name/modem          flags=display="Firmware";storagename="Firmware";mounttodecrypt;fsflags=ro

# Firmware-update Partitions
/abl             emmc    /dev/block/bootdevice/by-name/abl            flags=display="Firmware-update";storagename="Firmware-update";backup=1
/aop             emmc    /dev/block/bootdevice/by-name/aop            flags=backup=1;subpartitionof=/abl
/apdp            emmc    /dev/block/bootdevice/by-name/apdp           flags=backup=1;subpartitionof=/abl
/bluetooth       emmc    /dev/block/bootdevice/by-name/bluetooth      flags=backup=1;subpartitionof=/abl
/cmnlib          emmc    /dev/block/bootdevice/by-name/cmnlib         flags=backup=1;subpartitionof=/abl
/cmnlib64        emmc    /dev/block/bootdevice/by-name/cmnlib64       flags=backup=1;subpartitionof=/abl
/ddr             emmc    /dev/block/bootdevice/by-name/ddr            flags=backup=1;subpartitionof=/abl
/devcfg          emmc    /dev/block/bootdevice/by-name/devcfg         flags=backup=1;subpartitionof=/abl
/DRIVER          emmc    /dev/block/bootdevice/by-name/DRIVER         flags=backup=1;subpartitionof=/abl
/dsp             emmc    /dev/block/bootdevice/by-name/dsp            flags=backup=1;subpartitionof=/abl
/hyp             emmc    /dev/block/bootdevice/by-name/hyp            flags=backup=1;subpartitionof=/abl
/keymaster       emmc    /dev/block/bootdevice/by-name/keymaster      flags=backup=1;subpartitionof=/abl
/modem           emmc    /dev/block/bootdevice/by-name/modem          flags=backup=1;subpartitionof=/abl
/msadp           emmc    /dev/block/bootdevice/by-name/msadp          flags=backup=1;subpartitionof=/abl
/oppo_sec        emmc    /dev/block/bootdevice/by-name/oppo_sec       flags=backup=1;subpartitionof=/abl
/oppostanvbk     emmc    /dev/block/bootdevice/by-name/oppostanvbk    flags=backup=1;subpartitionof=/abl
/qupfw           emmc    /dev/block/bootdevice/by-name/qupfw          flags=backup=1;subpartitionof=/abl
/splash          emmc    /dev/block/bootdevice/by-name/splash         flags=backup=1;subpartitionof=/abl
/storsec         emmc    /dev/block/bootdevice/by-name/storsec        flags=backup=1;subpartitionof=/abl
/tz              emmc    /dev/block/bootdevice/by-name/tz             flags=backup=1;subpartitionof=/abl
/vbmeta_system   emmc    /dev/block/bootdevice/by-name/vbmeta_system  flags=backup=1;subpartitionof=/abl
/vbmeta_vendor   emmc    /dev/block/bootdevice/by-name/vbmeta_vendor  flags=backup=1;subpartitionof=/abl
/xbl             emmc    /dev/block/bootdevice/by-name/xbl            flags=backup=1;subpartitionof=/abl
/xbl_config      emmc    /dev/block/bootdevice/by-name/xbl_config     flags=backup=1;subpartitionof=/abl

# EFS Backup
/efs1            emmc    /dev/block/bootdevice/by-name/modemst1       flags=display="EFS";storagename="EFS";backup=1
/efs2            emmc    /dev/block/bootdevice/by-name/modemst2       flags=backup=1;subpartitionof=/efs1
/efsc            emmc    /dev/block/bootdevice/by-name/fsc            flags=backup=1;subpartitionof=/efs1
/efsg            emmc    /dev/block/bootdevice/by-name/fsg            flags=backup=1;subpartitionof=/efs1

# Device Security & State
/metadata        ext4    /dev/block/bootdevice/by-name/metadata       flags=display="Metadata";storagename="Metadata";backup=0
/persist         ext4    /dev/block/bootdevice/by-name/persist        flags=display="Persist";storagename="Persist"
/persist_image   emmc    /dev/block/bootdevice/by-name/persist        flags=display="Persist";storagename="Persist";flashimg;backup=1

# Userdata & Internal Storage
/data            f2fs    /dev/block/bootdevice/by-name/userdata       flags=display="Data";storagename="Data";backup=1;wipeingui;wipeduringfactoryreset;canbewiped;fileencryption=ice:wrappedkey;keydirectory=/metadata/vold/metadata_encryption;quota;fsflags="noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt"
/storage         ext4    /data/media/0                                flags=display="Internal Storage";storagename="Internal Storage";backup=0;usermrf;fsflags="bind,utf8"

# Removable Storage
/external_sd     auto    /dev/block/mmcblk0p1  /dev/block/mmcblk0     flags=display="MicroSD Card";storagename="MicroSD Card";storage;wipeingui;removable;fsflags="nosuid,nodev,utf8"
/usb_otg         auto    /dev/block/sdg1       /dev/block/sdg         flags=display="USB-Storage";storagename="USB-Storage";storage;wipeingui;removable;fsflags="utf8"
